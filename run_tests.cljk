(require '[kotoba.test :as t])

(doseq [ns-sym '[kizuna.tests.test-kizuna
                  kizuna.murakumo-test
                  kizuna.repository-contract-test]]
  (require ns-sym))

(let [result (apply t/run-tests
                    '[kizuna.tests.test-kizuna
                      kizuna.murakumo-test
                      kizuna.repository-contract-test])]
  (System/exit (if (zero? (+ (:fail result) (:error result))) 0 1)))
